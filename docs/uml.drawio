  <diagram name="Страница-1" id="jV_dBgiMAMUdtn5eUxv6">
    <mxGraphModel dx="2121" dy="1782" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection TB\n\nclass ConsoleApp {\n  &lt;&lt;Client&gt;&gt;\n  +main(String[] args)\n}\n\nclass HospitalSystem {\n  &lt;&lt;composition root&gt;&gt;\n  +facade() HospitalAdmissionFacade\n  +admin() AdmissionAdminFacade\n  +reset()\n}\n\nclass HospitalAdmissionFacade {\n  &lt;&lt;Facade 1 - client workflow&gt;&gt;\n  +admitPatient(AdmissionRequest) AdmissionResult\n}\n\nclass AdmissionAdminFacade {\n  &lt;&lt;Facade 2 - admin workflow&gt;&gt;\n  +listChains()\n  +inspect(String)\n  +inventory()\n  +compensateManually(String)\n  +recoverPendingChains()\n}\n\nclass ChainCompensator {\n  +compensate(String, String) List~String~\n}\n\nclass ChainRepository {\n  +create(String, String)\n  +setState(String, ChainState, String)\n  +findUnfinished()\n}\n\nclass ChainState {\n  &lt;&lt;enumeration&gt;&gt;\n  STARTED\n  PENDING_B\n  PENDING_C\n  COMPLETED\n  COMPENSATING\n  COMPENSATED\n  REJECTED\n}\n\nclass CrashPoint {\n  &lt;&lt;interface&gt;&gt;\n  +after(String step)\n}\n\nclass AdmissionRequest {\n  &lt;&lt;record&gt;&gt;\n}\n\nclass AdmissionResult {\n  &lt;&lt;record&gt;&gt;\n}\n\nclass RegistrationDesk {\n  &lt;&lt;A - service&gt;&gt;\n  +register(...) Registration\n  +cancelByChain(String)\n}\n\nclass Registration {\n  -status: RegistrationStatus\n  +moveTo(RegistrationStatus)\n}\n\nclass RegistrationStatus {\n  &lt;&lt;enumeration&gt;&gt;\n  PENDING\n  REGISTERED\n  CANCELLED\n}\n\nclass InsuranceVerifier {\n  &lt;&lt;business logic&gt;&gt;\n  +verify(...)\n}\n\nclass RegistrationRepository {\n  &lt;&lt;persistence gateway&gt;&gt;\n  +save(Registration)\n  +findByChainId(String)\n}\n\nclass ResourceService {\n  &lt;&lt;B - service&gt;&gt;\n  +allocate(...) ResourceBooking\n  +releaseByChain(String)\n}\n\nclass ResourceBooking {\n  -status: BookingStatus\n  +moveTo(BookingStatus)\n}\n\nclass BookingStatus {\n  &lt;&lt;enumeration&gt;&gt;\n  PENDING\n  ALLOCATED\n  RELEASED\n}\n\nclass BedAllocator {\n  &lt;&lt;business logic&gt;&gt;\n  +validate(...)\n  +choose(...)\n}\n\nclass ResourceRepository {\n  &lt;&lt;persistence gateway&gt;&gt;\n  +allocate(ResourceBooking)\n  +release(ResourceBooking)\n}\n\nclass ClinicalOrderService {\n  &lt;&lt;C - service&gt;&gt;\n  +place(...) ClinicalOrder\n  +cancelByChain(String)\n}\n\nclass ClinicalOrder {\n  -status: OrderStatus\n  +moveTo(OrderStatus)\n}\n\nclass OrderStatus {\n  &lt;&lt;enumeration&gt;&gt;\n  PENDING\n  CONFIRMED\n  CANCELLED\n}\n\nclass DrugSafetyChecker {\n  &lt;&lt;business logic&gt;&gt;\n  +validate(...)\n  +checkSafe(...)\n}\n\nclass ClinicalOrderRepository {\n  &lt;&lt;persistence gateway&gt;&gt;\n  +place(ClinicalOrder)\n  +cancel(ClinicalOrder)\n}\n\nConsoleApp --&gt; HospitalSystem\nConsoleApp --&gt; HospitalAdmissionFacade\nConsoleApp --&gt; AdmissionAdminFacade\nHospitalSystem ..&gt; HospitalAdmissionFacade : creates\nHospitalSystem ..&gt; AdmissionAdminFacade : creates\n\nHospitalAdmissionFacade --&gt; RegistrationDesk\nHospitalAdmissionFacade --&gt; ResourceService\nHospitalAdmissionFacade --&gt; ClinicalOrderService\nHospitalAdmissionFacade --&gt; ChainRepository\nHospitalAdmissionFacade *-- ChainCompensator\nHospitalAdmissionFacade --&gt; CrashPoint\nHospitalAdmissionFacade ..&gt; AdmissionRequest\nHospitalAdmissionFacade ..&gt; AdmissionResult\n\nAdmissionAdminFacade --&gt; RegistrationDesk\nAdmissionAdminFacade --&gt; ResourceService\nAdmissionAdminFacade --&gt; ClinicalOrderService\nAdmissionAdminFacade --&gt; ChainRepository\nAdmissionAdminFacade *-- ChainCompensator\n\nChainCompensator --&gt; RegistrationDesk\nChainCompensator --&gt; ResourceService\nChainCompensator --&gt; ClinicalOrderService\nChainCompensator --&gt; ChainRepository\nChainRepository ..&gt; ChainState\n\nRegistrationDesk --&gt; RegistrationRepository\nRegistrationDesk --&gt; InsuranceVerifier\nRegistrationDesk ..&gt; Registration\nRegistration --&gt; RegistrationStatus\n\nResourceService --&gt; ResourceRepository\nResourceService --&gt; BedAllocator\nResourceService ..&gt; ResourceBooking\nResourceBooking --&gt; BookingStatus\n\nClinicalOrderService --&gt; ClinicalOrderRepository\nClinicalOrderService --&gt; DrugSafetyChecker\nClinicalOrderService ..&gt; ClinicalOrder\nClinicalOrder --&gt; OrderStatus\n\nnote \&quot;Subsystems A, B and C never reference each other. They meet only inside the facades.\&quot; as N&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="ycqjGUWt0hJ35SnHx1C8-1">
